{
    "version": "0.5.11",
    "description": "An AI-powered coding IDE from Alibaba (China edition).",
    "homepage": "https://qoder.cn",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://qoder-app.oss-cn-beijing.aliyuncs.com/qoder-app/releases/latest/Qoder-CN-win-x64-user.exe#/dl.7z",
            "hash": "88ffcd652573d97c4bfde30eb6dc7a30ae975a58b6d167f8cdfdfb98e5dcc2e4"
        }
    },
    "installer": {
        "script": [
            "Get-Item \"$dir\\`$PLUGINSDIR\\app*.7z\" | Select-Object -First 1 | Expand-7zipArchive -DestinationPath $dir",
            "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Force -Recurse -ErrorAction Ignore",
            "$launcherDir = Join-Path $env:LOCALAPPDATA 'Qoder CN\\Qoder CN Launcher'",
            "New-Item -ItemType Directory -Path $launcherDir -Force | Out-Null",
            "$stateIni = Join-Path $launcherDir 'state.ini'",
            "if ((Test-Path $stateIni) -and -not (Test-Path \"$stateIni.bak\")) { Copy-Item $stateIni \"$stateIni.bak\" }",
            "$stamp = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss.fffZ')",
            "$installDir = Join-Path (Split-Path $dir -Parent) 'current'",
            "$lines = @('[launcher]', 'schemaVersion=3', 'status=healthy', \"installDir=$installDir\", 'appExecutable=Qoder CN.exe', \"targetVersion=$version\", \"updatedAt=$stamp\")",
            "[IO.File]::WriteAllLines($stateIni, [string[]]$lines, (New-Object System.Text.UTF8Encoding($false)))",
            "$installIni = Join-Path $launcherDir 'install.ini'",
            "if ((Test-Path $installIni) -and -not (Test-Path \"$installIni.bak\")) { Copy-Item $installIni \"$installIni.bak\" }",
            "[IO.File]::WriteAllLines($installIni, [string[]]$lines, (New-Object System.Text.UTF8Encoding($false)))",
            "$itJson = Join-Path $dir 'resources\\install-type.json'",
            "[IO.File]::WriteAllText($itJson, '{\"installType\":\"portable\"}', (New-Object System.Text.UTF8Encoding($false)))",
            "$lnkPath = Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Qoder CN.lnk'",
            "if ((Test-Path -LiteralPath $lnkPath) -and -not (Get-Item -LiteralPath $lnkPath -Force).PSIsContainer) { Remove-Item -LiteralPath $lnkPath -Force }",
            "if (-not (Test-Path -LiteralPath $lnkPath)) { New-Item -ItemType Directory -Path $lnkPath | Out-Null }",
            "$lnkItem = Get-Item -LiteralPath $lnkPath -Force",
            "$lnkItem.Attributes = $lnkItem.Attributes -bor [IO.FileAttributes]::Hidden"
        ]
    },
    "uninstaller": {
        "script": "Remove-Item -LiteralPath (Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Qoder CN.lnk') -Recurse -Force -ErrorAction Ignore"
    },
    "shortcuts": [
        [
            "Qoder CN.exe",
            "Qoder CN"
        ]
    ],
    "checkver": {
        "script": [
            "$r = Invoke-WebRequest -Uri 'https://qoder-app.oss-cn-beijing.aliyuncs.com/qoder-app/releases/latest/Qoder-CN-win-x64-user.exe' -Method Head -UseBasicParsing",
            "$r.Headers['x-oss-meta-version']"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://qoder-app.oss-cn-beijing.aliyuncs.com/qoder-app/releases/latest/Qoder-CN-win-x64-user.exe#/dl.7z"
            }
        }
    }
}
