{
    "version": "2.1.0-26111906",
    "description": "An AI office assistant from Alibaba that gets work done (China edition).",
    "homepage": "https://qwenwork.cn",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.qwenwork.cn/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://assets.qwenwork.cn/cicd/qwenworkcn/builds/261119/rel/3bf23777ee6747fb3d50591803e3588e/qwenworkcn_2.1.0-26111906_x64-update-package.7z",
            "hash": "md5:b3c5563e612ccc0f1669361381786eee",
            "extract_dir": "app"
        }
    },
    "shortcuts": [
        [
            "QwenWorkCN.exe",
            "千问办公"
        ]
    ],
    "checkver": {
        "script": [
            "$uuid = [guid]::NewGuid().ToString()",
            "$body = @{ appInfo = @{ name = 'qwenworkcn'; version = '1.0.0'; arch = 10; channel = 'stable' }; osInfo = @{ type = 0 }; hardwareInfo = @{ machineId = $uuid }; userInfo = @{ uuid = $uuid }; checkType = 0 }",
            "$r = Invoke-RestMethod -Uri 'https://clientupgrade.qwenwork.cn/upgrade/query' -Method POST -ContentType 'application/json' -Body ($body | ConvertTo-Json -Depth 5) -TimeoutSec 40",
            "$url = $r.upgradeInfo.resources[0].url",
            "$hashUrl = ($url -replace '[^/]+$') + 'manifest.json'",
            "Write-Output $r.upgradeInfo.version $url $hashUrl"
        ],
        "regex": "^(\\S+)\\s+(?<url>\\S+)\\s+(?<hashurl>\\S+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl",
                "hash": {
                    "url": "$matchHashurl",
                    "jsonpath": "$.artifacts[0].md5"
                }
            }
        }
    }
}
